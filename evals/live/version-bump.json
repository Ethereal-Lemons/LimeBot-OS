{
  "id": "version-bump",
  "category": "precise-edit",
  "prompt": "Bump the version from 1.4.2 to 1.5.0 everywhere it is the current version (code and docs). Do not rewrite old changelog entries; instead add a new `## 1.5.0` entry at the top of the list.",
  "fixtures": [
    {
      "path": "workspace/VERSION",
      "content": "1.4.2\n"
    },
    {
      "path": "workspace/pkg/__init__.py",
      "content": "__version__ = \"1.4.2\"\n"
    },
    {
      "path": "workspace/pkg/cli.py",
      "content": "VERSION = \"1.4.2\"\n\n\ndef show():\n    return f\"tool {VERSION}\"\n"
    },
    {
      "path": "workspace/docs/install.md",
      "content": "Install with `pip install tool==1.4.2`.\n"
    },
    {
      "path": "workspace/CHANGELOG.md",
      "content": "# Changelog\n\n## 1.4.21\n- Fix a typo.\n\n## 1.4.2\n- Add export.\n"
    }
  ],
  "hidden_fixtures": [],
  "solution": [
    {
      "path": "workspace/VERSION",
      "content": "1.5.0\n"
    },
    {
      "path": "workspace/pkg/__init__.py",
      "content": "__version__ = \"1.5.0\"\n"
    },
    {
      "path": "workspace/pkg/cli.py",
      "content": "VERSION = \"1.5.0\"\n\n\ndef show():\n    return f\"tool {VERSION}\"\n"
    },
    {
      "path": "workspace/docs/install.md",
      "content": "Install with `pip install tool==1.5.0`.\n"
    },
    {
      "path": "workspace/CHANGELOG.md",
      "content": "# Changelog\n\n## 1.5.0\n- Release.\n\n## 1.4.21\n- Fix a typo.\n\n## 1.4.2\n- Add export.\n"
    }
  ],
  "checks": {
    "files": [
      {
        "id": "version_file",
        "path": "workspace/VERSION",
        "equals": "1.5.0\n"
      },
      {
        "id": "package_version",
        "path": "workspace/pkg/__init__.py",
        "contains": "__version__ = \"1.5.0\""
      },
      {
        "id": "cli_version",
        "path": "workspace/pkg/cli.py",
        "contains": "VERSION = \"1.5.0\""
      },
      {
        "id": "docs_version",
        "path": "workspace/docs/install.md",
        "contains": "tool==1.5.0"
      },
      {
        "id": "new_changelog_entry",
        "path": "workspace/CHANGELOG.md",
        "contains": "## 1.5.0"
      },
      {
        "id": "old_entry_kept",
        "path": "workspace/CHANGELOG.md",
        "contains": "## 1.4.2\n- Add export."
      },
      {
        "id": "lookalike_kept",
        "path": "workspace/CHANGELOG.md",
        "contains": "## 1.4.21"
      }
    ]
  },
  "timeout_seconds": 240,
  "max_model_calls": 20,
  "max_tokens": 100000
}
